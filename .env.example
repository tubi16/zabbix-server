# General variables
OS=alpine
ZBX_VERSION=7.4
ZBX_IMAGE_REGISTRY=
ZBX_IMAGE_NAMESPACE=zabbix/
ZBX_IMAGE_TAG=${OS}-${ZBX_VERSION}-latest

# Zabbix images
ZABBIX_SERVER_MYSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-server-mysql
ZABBIX_SERVER_PGSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-server-pgsql
ZABBIX_PROXY_MYSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-proxy-mysql
ZABBIX_PROXY_SQLITE3_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-proxy-sqlite3
ZABBIX_WEB_NGINX_MYSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-web-nginx-mysql
ZABBIX_WEB_APACHE_MYSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-web-apache-mysql
ZABBIX_WEB_NGINX_PGSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-web-nginx-pgsql
ZABBIX_WEB_APACHE_PGSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-web-apache-pgsql
ZABBIX_JAVA_GATEWAY_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-java-gateway
ZABBIX_SNMPTRAPS_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-snmptraps
ZABBIX_WEB_SERVICE_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-web-service

# Database images
MYSQL_IMAGE=mysql
MYSQL_IMAGE_TAG=8.4-oracle
POSTGRESQL_IMAGE=postgres
POSTGRESQL_IMAGE_TAG=17-alpine
#POSTGRESQL_IMAGE=timescale/timescaledb
#POSTGRESQL_IMAGE_TAG=2.18.1-pg17

ELASTICSEARCH_IMAGE=elasticsearch
ELASTICSEARCH_IMAGE_TAG=8.19.12

WEBDRIVER_IMAGE=selenium/hub
WEBDRIVER_IMAGE_TAG=4.21.0
WEBDRIVER_CHROME_IMAGE=selenium/node-chrome
WEBDRIVER_CHROME_IMAGE_TAG=125.0
WEBDRIVER_FIREFOX_IMAGE=selenium/node-firefox
WEBDRIVER_FIREFOX_IMAGE_TAG=126.0

# Expose ports per service
ZABBIX_SERVER_PORT=10081
ZABBIX_PROXY_MYSQL_PORT=10071
ZABBIX_PROXY_SQLITE3_PORT=10061
ZABBIX_WEB_NGINX_HTTP_PORT=8080
ZABBIX_WEB_NGINX_HTTPS_PORT=8443
ZABBIX_WEB_APACHE_HTTP_PORT=8081
ZABBIX_WEB_APACHE_HTTPS_PORT=8443
ZABBIX_JAVA_GATEWAY_PORT=10052
ZABBIX_SNMPTRAPS_PORT=162
ZABBIX_WEB_SERVICE_PORT=10053

# Network IP ranges
FRONTEND_NETWORK_DRIVER=default
FRONTEND_SUBNET=172.28.238.0/24
FRONTEND_ENABLE_IPV6=false
BACKEND_NETWORK_DRIVER=default
BACKEND_SUBNET=172.28.239.0/24
BACKEND_ENABLE_IPV6=false
DATABASE_NETWORK_ENABLE_IPV6=false
DATABASE_NETWORK_DRIVER=default
ADD_TOOLS_NETWORK_DRIVER=default
ADD_TOOLS_SUBNET=172.28.240.0/24
ADD_TOOLS_ENABLE_IPV6=false

# Locations
DATA_DIRECTORY=./zbx_env
COMPONENT_DATA_DIRECTORY=../zbx_env
ENV_VARS_DIRECTORY=./env_vars
COMPONENT_ENV_VARS_DIRECTORY=../env_vars

# Options
RESTART_POLICY=unless-stopped

# Grafana
## Service Token

# Zabbix
## Service Token

# Local credentials: populate .env; never commit it.
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
ZABBIX_GRAFANA_USER=Admin
ZABBIX_GRAFANA_PASSWORD=
GRAFANA_SERVICE_TOKEN=
ZABBIX_SERVICE_TOKEN=

# Local server administration for host enrollment (not sent to devices)
ZABBIX_ADMIN_PASSWORD=
